# =============================================================================
# agentic-foundation — per-repository configuration (`.agentic/config.yml`)
# -----------------------------------------------------------------------------
# This single file makes the toolkit portable. The GitHub Actions workflows read
# from it instead of hardcoding any language, provider, or model.
#
# EASY BY DEFAULT: only the SIMPLE section below is required. Everything under
# ADVANCED is optional — unset values fall back to sensible defaults, then to
# your org/account `defaults`, then to the toolkit's documented fallbacks.
# Full reference: docs/CONFIGURATION.md
# =============================================================================
version: 1

# Optional: inherit base config(s) first; values in THIS file win. Layer an
# org base, then a team base, then this repo. Each item is a path or URI the
# installer can read. (String or list.)
# extends:
#   - org/agentic-base.yml
#   - team/backend.yml

# ===========================================================================
# SIMPLE — the minimum a repo needs. Bind each role to a provider and declare
# what "green" means. Models are optional here: leave them out and they resolve
# from `defaults.models` (below) or the org default. Set one only to override.
# ===========================================================================
roles:
  implementer:
    provider: claude          # claude | openai
  reviewer:
    provider: openai          # claude | openai

build:
  # Pick a preset to pre-fill commands, or set them directly. Language-agnostic:
  # the workflows run exactly what is here. Omit `build` entirely for a repo with
  # no build gate (e.g. docs-only).
  #   preset: python | maven | gradle | node | go | rust | dotnet | custom
  preset: custom
  commands:
    install: ""
    lint: ""
    test: ""
    typecheck: ""

# ===========================================================================
# ADVANCED — everything below is OPTIONAL. Delete any block to accept defaults.
# ===========================================================================

# --- Model resolution --------------------------------------------------------
# Precedence, highest first (most specific wins):
#   1. Per-request override supplied at dispatch time (workflow input / command)
#   2. This repo's per-role model  -> roles.<role>.model.(tiers.<tier> | default)
#   3. Org/account default         -> defaults.models.<provider>.(tiers.<tier> | default)
#   4. Toolkit built-in fallback   (installer fails loudly if nothing resolves)
# Set a model at ANY layer to override the ones below it; leave it unset to
# inherit. The toolkit ships placeholders, never hardcoded versions.
# ---------------------------------------------------------------------------

# Org/account-level defaults, by provider. Keep them here, or seed them from a
# shared org-level config. A role with no model of its own resolves to these.
defaults:
  models:
    claude:
      default: "<claude-default-model>"
      tiers:                       # used only when tiering.enabled = true
        trivial:  "<claude-low-cost-model>"
        standard: "<claude-default-model>"
        complex:  "<claude-high-capability-model>"
    openai:
      default: "<openai-default-model>"
      tiers:
        trivial:  "<openai-low-cost-model>"
        standard: "<openai-default-model>"
        complex:  "<openai-high-capability-model>"

# Provider-agnostic model aliases (optional). Reference these names anywhere a
# model is expected (role/tier/default) instead of a raw ID; map each per
# provider here so model-ID churn touches one place. Names are yours to choose.
# models:
#   aliases:
#     fast:     { claude: "<claude-fast>",     openai: "<openai-fast>" }
#     balanced: { claude: "<claude-balanced>", openai: "<openai-balanced>" }
#     strong:   { claude: "<claude-strong>",   openai: "<openai-strong>" }

# Provider connections (optional). Point at self-hosted / Azure OpenAI / proxy /
# on-prem gateways. Supply only the NAME of the secret holding the key — never
# the key itself. Everything is optional; omit to use the provider default.
# providers:
#   claude:
#     base_url: ""                         # custom endpoint; blank = provider default
#     api_key_secret: ANTHROPIC_API_KEY    # name of the secret to read
#   openai:
#     base_url: ""                         # e.g. https://<resource>.openai.azure.com
#     api_version: ""                      # e.g. Azure OpenAI api-version
#     deployment: ""                       # Azure deployment name, if applicable
#     api_key_secret: OPENAI_API_KEY

# Per-role overrides. Uncomment ONLY the fields you want to pin for this repo;
# anything omitted inherits from `defaults.models.<provider>` above.
# roles:
#   implementer:
#     provider: claude
#     model:
#       default: "<override-model>"     # override just the default...
#       tiers:
#         complex: "<override-model>"   # ...or just one tier
#   reviewer:
#     provider: openai
#     model:
#       default: "<override-model>"

# --- Access & merge authority ------------------------------------------------
repository:
  default_branch: main
  # GitHub author_association values allowed to drive agentic changes.
  trusted_authors: [OWNER, MEMBER, COLLABORATOR]
  # true = act only on same-repo PR heads (no fork PRs). Keep true unless you
  # deliberately accept and trust fork contributions (widens the threat model).
  same_repo_only: true

labels:
  # A PR carrying this label is NEVER auto-merged (human keeps merge authority).
  human_merge: human-merge
  # Optional: label that dispatches an implementation task from an issue.
  dispatch: agentic-task

# --- Dynamic model selection -------------------------------------------------
# The deterministic classifier reuses the review router's change-size + path
# signal, so tier selection costs NO extra model call. A trivial textual/config
# change runs on the low-cost tier; a large or broad change escalates to complex.
tiering:
  enabled: true
  classifier: deterministic        # v1: deterministic only
  thresholds:
    trivial:
      max_files: 5
      max_lines: 50
      only_paths: ["**/*.md", "docs/**", "**/*.txt"]
    complex:
      min_files: 20
      min_lines: 400
    # A change that is neither trivial nor complex is treated as "standard".

# --- Review routing ----------------------------------------------------------
# Trivial textual changes are fast-path approved WITHOUT a model review;
# everything else is routed to the configured reviewer.
routing:
  fast_path:
    globs: ["**/*.md", "docs/**"]
    max_files: 20
    max_lines: 200
    exclude: ["AGENTS.md", "CLAUDE.md", ".agentic/**"]

# --- Cost & token budgets ----------------------------------------------------
# Optional ceilings. Set only what you want enforced; on_exceed decides the
# action when a limit is hit.
# budgets:
#   enabled: true
#   currency: USD
#   per_run:    { max_usd: 2.00, max_tokens: 500000 }
#   per_period: { window: monthly, max_usd: 200.00 }
#   on_exceed: block               # block | downgrade (to a cheaper tier) | warn

# --- Prompt-injection guardrails ---------------------------------------------
# Treat content from PRs/issues/comments/diffs as data, not instructions.
# guardrails:
#   untrusted_inputs: [pr_body, issue_body, comments, diff, code_comments]
#   ignore_inline_directives: true       # ignore "instructions" embedded in the above
#   allowed_tools: []                    # optional allowlist of tools the agent may use
#   max_context_files: 200
#   redact_secrets_in_context: true

# --- Observability / audit trail ---------------------------------------------
# Where run records go — adapt to YOUR stack. Endpoints come from a variable/
# secret NAME (never hardcoded), and secrets are always redacted from output.
# observability:
#   enabled: true
#   format: json                   # json | text
#   redact_secrets: true           # secrets are always redacted regardless
#   sinks:
#     - type: artifact             # none | artifact | file | webhook | otlp
#     - type: otlp
#       endpoint_var: OTEL_EXPORTER_OTLP_ENDPOINT   # name of a repo/org variable
#       headers_secret: OTEL_EXPORTER_OTLP_HEADERS  # name of a secret

# --- Optional add-on modules -------------------------------------------------
# Core (implement + review + routing + thread resolution) is always installed;
# these are opt-in and off by default.
modules:
  auto_merge: false                # fail-closed foundation auto-merge gate
  sonar: false                     # SonarCloud/SonarQube quality gate
