name: Auto-merge eligible PRs

# Rendered by the stagr CLI (from stagr/templates/workflows/github/). Do not edit by hand; edit the
# template and re-render. Emitted only when `modules.auto_merge` is enabled in .agentic/config.yml.
#
# It auto-merges a PR once it is PROVABLY READY — green CI, a head-bound Codex code review and (when a
# security stage is configured) a head-bound Codex security review, no unresolved review threads, no
# reviewer requesting changes, and every operator-configured external quality/security check green — so a
# human is not the bottleneck for provably-ready work. A PR that needs human judgement carries the
# `{{ human_merge_label }}` label (a HARD STOP), or changes the control plane (see merge.protected_paths).
#
# SECURITY POSTURE (this workflow writes to the default branch; if branch protection is not enforced, the
# workflow itself is the gate):
#   * It runs only as pull_request_target / pull_request_review / issue_comment / check_suite / schedule /
#     workflow_dispatch — NEVER on a `pull_request` trigger — so the workflow definition and token always
#     come from the trusted base branch, never from PR head.
#   * It NEVER checks out or executes PR content. It reads PR metadata, checks, reviews and comments as
#     data through the API only (jq over JSON), so untrusted PR code can never reach the merge token.
#   * It is FAIL-CLOSED: every gate must positively prove mergeability. Any missing signal, unknown state,
#     or API error results in "skip, do not merge". A skipped PR is re-evaluated on the next event or sweep.
#   * Eligibility: open, not draft, not already merged, head in THIS repo (no forks), base is the default
#     branch, a trusted author association, and NO `{{ human_merge_label }}` label.
#   * CONTROL-PLANE GUARD: a PR that changes a merge.protected_paths file (CI/gate workflows, the toolkit
#     config/contract) is left for a human. This is what covers workflow-CONTENT substitution — e.g. a
#     same-repo PR weakening validate.yml — which a check name + head-SHA match alone cannot authenticate.
#   * Every gate is re-evaluated a SECOND time against freshly-fetched state immediately before merging,
#     and the merge is pinned to the evaluated head SHA (`sha=`), so a PR whose head moved, whose checks
#     went red, or that gained a label/changes-request between the two reads is not merged. This narrows
#     but cannot fully eliminate the last-read→merge race (GitHub's API is not transactional); branch
#     protection marking these checks required is the only server-atomic closure — see AGENTS.md.
#
# It uses the workflow GITHUB_TOKEN (contents+PR write) to merge (method from merge.method; default
# squash — the target repo must have that method enabled). Known limitation: a merge pushed with
# GITHUB_TOKEN does not itself trigger downstream workflows (e.g. a deploy-on-merge).
on:
  pull_request_target:
    types: [labeled, unlabeled, opened, reopened, synchronize, ready_for_review]
  pull_request_review:
    types: [submitted, dismissed]
  issue_comment:
    types: [created]
  check_suite:
    types: [completed]
  schedule:
    # Safety-net sweep: catches PRs that became mergeable via a signal that fired no event we subscribe to
    # (CI going green after a push; a review thread resolved — GitHub emits no Actions event for that). It
    # is also the PRIMARY merge driver: an event-driven run sees its OWN in-progress check-run on the head
    # and defers (fail-closed), and this sweep merges once that run has completed.
    - cron: '*/15 * * * *'
  workflow_dispatch: {}

# Least privilege: contents write + PR write to perform the merge; checks/statuses read to verify CI;
# actions read to query the trusted Validate workflow run. (Head-branch cleanup is left to GitHub's own
# auto-delete setting, not this workflow.)
permissions:
  contents: write
  pull-requests: write
  checks: read
  statuses: read
  actions: read

# One evaluation per PR at a time (per-PR events), and a single shared slot for the whole-repo sweeps
# (schedule / check_suite / workflow_dispatch). Never cancel an in-flight run — a cancelled merge could
# leave state half-done; the merge call is idempotent, so letting runs finish is safe.
concurrency:
  group: auto-merge-${{ github.event.pull_request.number || github.event.issue.number || 'sweep' }}
  cancel-in-progress: false

env:
  HUMAN_MERGE_LABEL: "{{ human_merge_label }}"
  # Must match the context published by the review router; its presence is part of "every status green".
  REVIEW_STATUS_CONTEXT: "{{ review_status_context }}"
  CODEX_BOT_LOGIN: chatgpt-codex-connector[bot]
  TRUSTED_ROLES: '{{ trusted_roles_json }}'
  # Whether a head-bound Codex code / security review is required before merge. Rendered "true" only when
  # the pipeline actually produces one, so a pipeline without that stage does not deadlock.
  REQUIRE_CODEX_CODE_REVIEW: "{{ require_codex_code_review }}"
  REQUIRE_CODEX_SECURITY_REVIEW: "{{ require_codex_security_review }}"
  # Operator external quality/security checks (merge.required_status_checks): a JSON array of {name, app_id}
  # — the EXACT check-run name AND the immutable numeric GitHub App id that must produce it. Identity is
  # positive (name + app.id), never "any app but github-actions": a display name alone is not an identity.
  REQUIRED_STATUS_CHECKS: '{{ required_status_checks_json }}'
  # Control-plane globs (merge.protected_paths): a PR changing any matching file is left for a human.
  MERGE_PROTECTED_PATHS: '{{ merge_protected_paths_json }}'

jobs:
  auto-merge:
    name: Auto-merge eligible PRs
    # issue_comment fires for plain issues too; only proceed when it is on a pull request.
    if: >-
      github.event_name != 'issue_comment' || github.event.issue.pull_request != null
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Evaluate candidates and merge the eligible ones
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
          EVENT_NAME: ${{ github.event_name }}
          EVENT_DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
          PR_FROM_PULL: ${{ github.event.pull_request.number }}
          PR_FROM_ISSUE: ${{ github.event.issue.number }}
        run: |
          set -euo pipefail

          REPO="$GITHUB_REPOSITORY"
          DEFAULT_BRANCH="${EVENT_DEFAULT_BRANCH:-}"
          if [[ -z "$DEFAULT_BRANCH" ]]; then
            # schedule / workflow_dispatch payloads carry no repository object.
            DEFAULT_BRANCH="$(gh api "repos/$REPO" --jq '.default_branch')"
          fi

          # Control-plane globs into an array (fail-closed to the safe default if the JSON is unreadable).
          declare -a PROTECTED=()
          mapfile -t PROTECTED < <(jq -r '.[]?' <<<"$MERGE_PROTECTED_PATHS") \
            || PROTECTED=(".github/workflows/**" ".agentic/**")

          # --- Build the candidate PR list ---------------------------------------------------
          # Per-PR events (pull_request_target / pull_request_review / issue_comment) evaluate exactly one
          # PR; every other trigger (check_suite / schedule / workflow_dispatch) is a whole-repo SWEEP over
          # open PRs targeting the default branch. One PR's outcome never aborts the others.
          declare -a PRS=()
          case "$EVENT_NAME" in
            pull_request_target|pull_request_review)
              [[ -n "${PR_FROM_PULL:-}" && "$PR_FROM_PULL" != "null" ]] && PRS=("$PR_FROM_PULL") ;;
            issue_comment)
              [[ -n "${PR_FROM_ISSUE:-}" && "$PR_FROM_ISSUE" != "null" ]] && PRS=("$PR_FROM_ISSUE") ;;
            *)
              # GET params via -f so a branch name containing '&', '#', etc. is URL-encoded rather than
              # parsed as query syntax (which would query the wrong base and skip eligible PRs).
              mapfile -t PRS < <(gh api --paginate --method GET "repos/$REPO/pulls" \
                -f state=open -f "base=$DEFAULT_BRANCH" -f per_page=100 \
                --jq '.[].number') || PRS=() ;;
          esac

          if [[ ${#PRS[@]} -eq 0 ]]; then
            echo "No candidate PRs for event '$EVENT_NAME'."
            exit 0
          fi

          # skip <pr> <reason>: record a fail-closed decision (a skip is not an error).
          skip() { echo "SKIP #$1: $2"; }

          # path_is_protected <file>: 0 if the file matches any control-plane glob. `[[ == ]]` glob match
          # (not pathname expansion), so `*`/`**` match across '/', which is what the dir globs want.
          path_is_protected() {
            local f="$1" p
            for p in "${PROTECTED[@]}"; do
              # shellcheck disable=SC2053
              [[ "$f" == $p ]] && return 0
            done
            return 1
          }

          # count_unresolved_threads <pr>: number of unresolved review threads (any author), PAGINATED.
          count_unresolved_threads() {
            local pr="$1" q cursor="null" resp total=0 page has_next
            q='query($owner:String!,$repo:String!,$number:Int!,$cursor:String){
                 repository(owner:$owner,name:$repo){
                   pullRequest(number:$number){
                     reviewThreads(first:100,after:$cursor){
                       nodes{ isResolved }
                       pageInfo{ hasNextPage endCursor }
                     }}}}'
            local owner="${REPO%%/*}" name="${REPO#*/}"
            while :; do
              if [[ "$cursor" == "null" ]]; then
                resp="$(gh api graphql -f query="$q" -f owner="$owner" -f repo="$name" -F number="$pr")" || return 1
              else
                resp="$(gh api graphql -f query="$q" -f owner="$owner" -f repo="$name" -F number="$pr" -f cursor="$cursor")" || return 1
              fi
              page="$(jq -r '[.data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved==false)] | length' <<<"$resp")" || return 1
              total=$((total + page))
              has_next="$(jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.hasNextPage' <<<"$resp")"
              [[ "$has_next" == "true" ]] || break
              cursor="$(jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.endCursor' <<<"$resp")"
            done
            echo "$total"
          }

          # gates_pass <pr>: run EVERY fail-closed gate against freshly-fetched state. On success sets the
          # global GATE_HEAD to the evaluated head SHA and returns 0; on any failing gate logs a skip and
          # returns 1. It fetches its own evidence each call, so calling it twice re-validates against fresh
          # state (closing most of the evaluate→merge staleness window).
          GATE_HEAD=""
          gates_pass() {
            local pr="$1"
            GATE_HEAD=""

            local pr_json
            pr_json="$(gh api "repos/$REPO/pulls/$pr")" || { skip "$pr" "cannot fetch PR"; return 1; }

            local state merged draft head_sha head_repo base_ref author_assoc mergeable mergeable_state
            state="$(jq -r '.state' <<<"$pr_json")"
            merged="$(jq -r '.merged' <<<"$pr_json")"
            draft="$(jq -r '.draft' <<<"$pr_json")"
            head_sha="$(jq -r '.head.sha' <<<"$pr_json")"
            head_repo="$(jq -r '.head.repo.full_name // ""' <<<"$pr_json")"
            base_ref="$(jq -r '.base.ref' <<<"$pr_json")"
            author_assoc="$(jq -r '.author_association' <<<"$pr_json")"
            mergeable="$(jq -r '.mergeable' <<<"$pr_json")"
            mergeable_state="$(jq -r '.mergeable_state' <<<"$pr_json")"

            # --- Eligibility (fail-closed) ---
            [[ "$state" == "open" ]]               || { skip "$pr" "state=$state"; return 1; }
            [[ "$merged" == "false" ]]             || { skip "$pr" "already merged"; return 1; }
            [[ "$draft" == "false" ]]              || { skip "$pr" "draft"; return 1; }
            [[ "$head_repo" == "$REPO" ]]          || { skip "$pr" "head is a fork ($head_repo)"; return 1; }
            [[ "$base_ref" == "$DEFAULT_BRANCH" ]] || { skip "$pr" "base=$base_ref not $DEFAULT_BRANCH"; return 1; }
            printf '%s' "$TRUSTED_ROLES" | jq -e --arg a "$author_assoc" 'index($a) != null' >/dev/null 2>&1 \
              || { skip "$pr" "untrusted author_association=$author_assoc"; return 1; }
            if jq -e --arg L "$HUMAN_MERGE_LABEL" 'any(.labels[]?; .name==$L)' <<<"$pr_json" >/dev/null; then
              skip "$pr" "labelled '$HUMAN_MERGE_LABEL' (human-gated)"; return 1
            fi
            [[ "$mergeable" == "true" ]] || { skip "$pr" "mergeable=$mergeable (conflict or still computing)"; return 1; }
            # clean rejects behind/dirty/blocked/unstable/unknown, so the checks verified below reflect the
            # current base+head pair.
            [[ "$mergeable_state" == "clean" ]] || { skip "$pr" "mergeable_state=$mergeable_state (not clean)"; return 1; }

            # --- Control-plane guard: a PR touching a protected path is human-gated ---
            local files_json f
            files_json="$(gh api --paginate "repos/$REPO/pulls/$pr/files?per_page=100" --slurp | jq 'add // []')" \
              || { skip "$pr" "cannot read changed files"; return 1; }
            # Check BOTH the current filename AND, for a rename, the previous_filename: a PR can rename a
            # protected file (e.g. .github/workflows/auto-merge.yml) to an unprotected path, moving the
            # protected path into .previous_filename — checking only .filename would let that removal through.
            while IFS= read -r f; do
              [[ -n "$f" ]] || continue
              if path_is_protected "$f"; then
                skip "$pr" "changes control-plane path '$f' (human-gated; see merge.protected_paths)"; return 1
              fi
            done < <(jq -r '.[] | (.filename, (.previous_filename // empty))' <<<"$files_json")

            # --- CI must be green ---
            local status_json status_state
            status_json="$(gh api --paginate "repos/$REPO/commits/$head_sha/status?per_page=100" --slurp \
              | jq '{state: (.[0].state // "pending"), statuses: (map(.statuses) | add // [])}')" \
              || { skip "$pr" "cannot read combined status"; return 1; }
            status_state="$(jq -r '.state' <<<"$status_json")"
            [[ "$status_state" == "success" ]] || { skip "$pr" "combined status=$status_state"; return 1; }

            # Review-router status present + successful (part of "every status green"). Its DESCRIPTION is
            # deliberately NOT read to waive a review: any actor with statuses:write could forge it.
            local router_state
            router_state="$(jq -r --arg c "$REVIEW_STATUS_CONTEXT" \
              '[.statuses[] | select(.context==$c)] | (sort_by(.updated_at) | last) | (.state // "missing")' <<<"$status_json")"
            [[ "$router_state" == "success" ]] || { skip "$pr" "review router status=$router_state"; return 1; }

            # EVERY check-run must be terminal and passing. Identity is (app.id, name); the LATEST attempt
            # by check-run id decides (a later cancelled/queued/failed rerun is NOT superseded by an older
            # success — no fallback to a stale green). Accepted terminal conclusions: success/neutral/
            # skipped. This includes THIS workflow's own in-progress run, so an event-driven attempt defers
            # and the scheduled sweep merges once it completes (no name-based exclusion, which would be a
            # bypass). Fetch first (fail-closed on API error).
            local cr_json bad_checks
            cr_json="$(gh api --paginate "repos/$REPO/commits/$head_sha/check-runs?per_page=100" --slurp \
              | jq 'map(.check_runs) | add // []')" || { skip "$pr" "cannot read check-runs"; return 1; }
            bad_checks="$(jq -r '
                [ group_by([.app.id, .name])[]
                  | (sort_by(.id) | last)
                  | select( (.status != "completed")
                            or ( .conclusion | IN("success","neutral","skipped") | not ) )
                ] | length' <<<"$cr_json")"
            [[ "$bad_checks" == "0" ]] || { skip "$pr" "$bad_checks check-run(s) whose latest attempt is pending/failed"; return 1; }

            # Mandatory Validate, authenticated by producer AND by the trusted workflow file for this exact
            # head: (a) a check-run named "Validate" from the github-actions App that succeeded, AND (b) a
            # successful run of the trusted workflow FILE validate.yml for this head SHA. This blocks a PR
            # that deletes/renames validate.yml (no such run). CONTENT substitution (a same-repo PR that
            # weakens validate.yml but keeps the name/path) is covered by the control-plane guard above,
            # which leaves any PR touching .github/workflows for a human.
            local validate_ok validate_run_ok
            validate_ok="$(jq -r '[ group_by([.app.id, .name])[] | (sort_by(.id) | last)
                | select(.name=="Validate" and ((.app.slug // "")=="github-actions") and .status=="completed" and .conclusion=="success") ] | length' <<<"$cr_json")"
            validate_run_ok="$(gh api "repos/$REPO/actions/workflows/validate.yml/runs?head_sha=$head_sha&per_page=100" \
              --jq '[.workflow_runs[] | select(.conclusion=="success")] | length' 2>/dev/null || echo 0)"
            if [[ "$validate_ok" == "0" || "$validate_run_ok" == "0" ]]; then
              skip "$pr" "required Validate not present+successful from the trusted workflow (github-actions check: $validate_ok, validate.yml run for head: $validate_run_ok)"; return 1
            fi

            # --- Operator external quality/security checks (merge.required_status_checks) ---
            # Each entry is {name, app_id}: require a check-run of that exact name AND that producing App id
            # whose LATEST attempt (by id) is completed+success. Positive identity — a same-name check from
            # any other App (including github-actions) does NOT satisfy it. Absent = fail-closed.
            local entry req_name req_app cr_verdict
            while IFS= read -r entry; do
              [[ -n "$entry" ]] || continue
              req_name="$(jq -r '.name' <<<"$entry")"
              req_app="$(jq -r '.app_id' <<<"$entry")"
              cr_verdict="$(jq -r --arg n "$req_name" --argjson aid "$req_app" \
                  '[ .[] | select(.name==$n and (.app.id==$aid)) ] as $runs
                   | if ($runs|length)==0 then "absent"
                     else ($runs | sort_by(.id) | last
                           | if (.status=="completed" and .conclusion=="success") then "ok" else "bad" end)
                     end' <<<"$cr_json")"
              case "$cr_verdict" in
                ok) ;;
                absent) skip "$pr" "required check '$req_name' (app_id $req_app) is absent on the head"; return 1 ;;
                *)      skip "$pr" "required check '$req_name' (app_id $req_app) latest attempt is not a clean success"; return 1 ;;
              esac
            done < <(jq -c '.[]?' <<<"$REQUIRED_STATUS_CHECKS")

            # --- Review must be clean ---
            local unresolved
            unresolved="$(count_unresolved_threads "$pr")" || { skip "$pr" "cannot read review threads"; return 1; }
            [[ "$unresolved" == "0" ]] || { skip "$pr" "$unresolved unresolved review thread(s)"; return 1; }

            local reviews_json blocking
            reviews_json="$(gh api --paginate "repos/$REPO/pulls/$pr/reviews?per_page=100" --slurp | jq 'add // []')" \
              || { skip "$pr" "cannot read reviews"; return 1; }
            # No reviewer's latest decisive review is CHANGES_REQUESTED. Group by numeric user.id (stable
            # across renames); latest by numeric review id (monotonic, not a nullable timestamp).
            blocking="$(jq -r '[ .[] | select(.state=="APPROVED" or .state=="CHANGES_REQUESTED" or .state=="DISMISSED") ]
                              | group_by(.user.id) | map(sort_by(.id) | last)
                              | map(select(.state=="CHANGES_REQUESTED")) | length' <<<"$reviews_json")"
            [[ "$blocking" == "0" ]] || { skip "$pr" "$blocking reviewer(s) requested changes"; return 1; }

            # --- Codex CODE review completed for the current head (when configured) ---
            # Prefer a canonical head-bound review OBJECT: exact actor, full commit_id == head_sha, body
            # carrying the code-review marker "Codex Review" (distinct from "Codex Security Review" and from
            # a bare error body), state not DISMISSED. The review object's commit_id is the full 40-char SHA
            # (authoritative). Fall back to the summary comment's "Code Review … Completed" row ONLY when no
            # head-bound code-review object exists at all (a clean review may post no object); that row
            # carries only an abbreviated SHA, so its head-binding is a documented residual, weaker than the
            # object path.
            local summary_body=""
            if [[ "$REQUIRE_CODEX_CODE_REVIEW" == "true" ]]; then
              local codex_head_reviewed=false codex_code_latest codex_state
              codex_code_latest="$(jq -c --arg bot "$CODEX_BOT_LOGIN" --arg head "$head_sha" \
                '[ .[] | select(.user.login==$bot and .commit_id==$head and ((.body // "")|test("Codex Review"))) ]
                 | sort_by(.id) | last // {}' <<<"$reviews_json")"
              codex_state="$(jq -r '.state // ""' <<<"$codex_code_latest")"
              if [[ -n "$codex_state" ]]; then
                # A head-bound code-review object exists: it decides (no summary fallback).
                if [[ "$codex_state" == "DISMISSED" ]]; then
                  skip "$pr" "latest Codex code review of the current head is DISMISSED"; return 1
                fi
                codex_head_reviewed=true
              else
                local pr_comments code_row row_sha
                pr_comments="$(gh api --paginate "repos/$REPO/issues/$pr/comments?per_page=100" --slurp | jq 'add // []')" \
                  || { skip "$pr" "cannot read PR comments for Codex review summary"; return 1; }
                summary_body="$(jq -r --arg bot "$CODEX_BOT_LOGIN" \
                  '[ .[] | select(.user.login==$bot) | .body | select(contains("codex-pull-request-review-summary")) ] | last // ""' <<<"$pr_comments")"
                code_row="$(grep -i 'Code Review' <<<"$summary_body" | head -1 || true)"
                if grep -qi 'Completed' <<<"$code_row"; then
                  row_sha="$(grep -oE '`[0-9a-f]{7,40}`' <<<"$code_row" | head -1 | tr -d '`' || true)"
                  if [[ -n "$row_sha" && "$head_sha" == "$row_sha"* ]]; then
                    codex_head_reviewed=true
                  fi
                fi
              fi
              [[ "$codex_head_reviewed" == true ]] || { skip "$pr" "no completed Codex code review for current head $head_sha"; return 1; }
            fi

            # --- Codex SECURITY review completed for the current head (when configured) ---
            # The final security review runs once after the code review converges. Its summary row carries a
            # hidden machine-readable marker with the FULL head SHA
            # (<!-- codex-security-review:v1 {"headSha":"<full40>","status":"completed"} -->); bind to that
            # full SHA when present, else fall back to the visible "Security Review … Completed" row (abbrev
            # SHA — documented residual).
            if [[ "$REQUIRE_CODEX_SECURITY_REVIEW" == "true" ]]; then
              local sec_head_reviewed=false sec_row sec_row_sha
              if [[ -z "${summary_body:-}" ]]; then
                local sec_pr_comments
                sec_pr_comments="$(gh api --paginate "repos/$REPO/issues/$pr/comments?per_page=100" --slurp | jq 'add // []')" \
                  || { skip "$pr" "cannot read PR comments for Codex security-review summary"; return 1; }
                summary_body="$(jq -r --arg bot "$CODEX_BOT_LOGIN" \
                  '[ .[] | select(.user.login==$bot) | .body | select(contains("codex-pull-request-review-summary")) ] | last // ""' <<<"$sec_pr_comments")"
              fi
              # Preferred: the hidden machine-readable marker carrying the FULL head SHA. Order-independent:
              # require the security marker, the exact 40-char headSha for THIS head, and status completed.
              if grep -q 'codex-security-review' <<<"$summary_body" \
                 && grep -qE "\"headSha\":\"${head_sha}\"" <<<"$summary_body" \
                 && grep -qE '"status":"completed"' <<<"$summary_body"; then
                sec_head_reviewed=true
              else
                sec_row="$(grep -i 'Security Review' <<<"$summary_body" | head -1 || true)"
                if grep -qi 'Completed' <<<"$sec_row"; then
                  sec_row_sha="$(grep -oE '`[0-9a-f]{7,40}`' <<<"$sec_row" | head -1 | tr -d '`' || true)"
                  if [[ -n "$sec_row_sha" && "$head_sha" == "$sec_row_sha"* ]]; then
                    sec_head_reviewed=true
                  fi
                fi
              fi
              [[ "$sec_head_reviewed" == true ]] || { skip "$pr" "no completed Codex security review for current head $head_sha"; return 1; }
            fi

            GATE_HEAD="$head_sha"
            return 0
          }

          # evaluate_pr <pr>: gate twice against fresh state, require an unchanged head, then merge pinned to
          # that head. Always returns 0 (a skip is not an error) so the sweep continues.
          evaluate_pr() {
            local pr="$1" head1 err
            echo "::group::Evaluate PR #$pr"
            gates_pass "$pr" || { echo '::endgroup::'; return 0; }
            head1="$GATE_HEAD"
            # Second, independent evaluation immediately before merge: re-fetches all evidence (CI, checks,
            # reviews, label, mergeability), so a gate that flipped since the first pass stops the merge.
            gates_pass "$pr" || { echo '::endgroup::'; return 0; }
            [[ "$head1" == "$GATE_HEAD" ]] || { skip "$pr" "head moved between evaluations"; echo '::endgroup::'; return 0; }

            echo "#$pr: all gates green (twice) — merging ({{ merge_method }}) at $GATE_HEAD"
            if err="$(gh api --method PUT "repos/$REPO/pulls/$pr/merge" \
                        -f merge_method={{ merge_method }} -f sha="$GATE_HEAD" 2>&1 >/dev/null)"; then
              echo "Merged #$pr."
              # Head-branch cleanup is intentionally left to GitHub's "Automatically delete head branches"
              # setting: the REST API has no atomic compare-and-delete, so a read-then-delete would race a
              # push that advances the branch after the read.
            else
              skip "$pr" "merge call failed (head moved or not mergeable): $err"
            fi
            echo '::endgroup::'
            return 0
          }

          for pr in "${PRS[@]}"; do
            evaluate_pr "$pr" || true
          done
