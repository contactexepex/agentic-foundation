name: Validate

# Rendered by install/render.py from templates/workflows/github/. Do not edit by hand;
# edit the template and re-render. The repository's "green" check.
on:
  pull_request:
    types: [opened, reopened, synchronize, ready_for_review]
  push:
    branches: [{{ default_branch }}]
  workflow_dispatch: {}

concurrency:
  group: validate-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  validate:
    # The job name IS the check-run name the auto-merge gate requires by name.
    name: Validate
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.0.0
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: '3.12'
      - name: Install validators
        run: |
          python -m pip install --only-binary=:all: jsonschema pyyaml
      - name: Validate contract
        run: |
          python .github/scripts/validate_config.py
