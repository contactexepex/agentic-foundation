# =============================================================================
# agentic-foundation — per-repository configuration (`.agentic/config.yml`)
# -----------------------------------------------------------------------------
# A platform-neutral contract for a graph of SDLC/STLC agent stages. One file
# makes the toolkit portable: it never hardcodes a language, provider, model,
# or SCM platform.
#
# EASY BY DEFAULT: pick a `profile` and a `platform`; the profile expands to a
# default stage graph. ADD `stages:` only for granular control. Model resolution
# is fail-loud (no hidden fallback): a stage on a model-consuming backend
# (`generic`/`claude-code-action`) needs a resolvable model under `defaults` or
# `stages[].model`; app backends (e.g. `codex`) supply their own. Else all optional.
# Full reference: docs/CONFIGURATION.md   Design: docs/ARCHITECTURE.md
# =============================================================================
version: 2

# Optional: inherit base config(s) first; values in THIS file win. Layer an
# org base, then a team base, then this repo. (String or list.)
# Bases must live INSIDE this repo checkout (vendor a shared org base in — commit
# it or fetch it at checkout); a path outside the repo is rejected at load time.
# extends:
#   - .agentic/base/org.yml
#   - .agentic/base/backend.yml

# ===========================================================================
# SIMPLE — a profile + a platform. (Add a model default under `defaults` for any
# stage whose backend consumes one; app backends like `codex` supply their own.)
# ===========================================================================

# Onboarding shortcut. Expands to a default stage graph you can override below.
#   minimal  = implement + review (advisory; humans merge)
#   standard = implement + review (blocking) + security (advisory)   <- default
#   full     = implement + security + test + integration-test + review
#   custom   = no auto stages; you define them all under `stages:`
profile: standard

platform:
  type: github                 # github | gitlab | azure_devops | bitbucket | gitea | other
  # host: ""                   # self-hosted/enterprise host; blank = public host
  default_branch: main
  # auth: { token_secret: REMEDIATION_TOKEN }  # NAME of the real-user PAT that pushes the
  #                                            # implementer's fixes / re-requests reviews.
  #                                            # Default: REMEDIATION_TOKEN.

build:
  # What "green" means for THIS repo. Language-agnostic; omit for docs-only.
  #   preset: python | maven | gradle | node | go | rust | dotnet | custom
  preset: custom
  commands:
    install: ""
    lint: ""
    test: ""
    typecheck: ""

# ===========================================================================
# MODEL DEFAULTS (required for the Anthropic implementer) + ADVANCED (optional).
# Resolution is fail-loud: an `anthropic` stage (Claude Code) needs a model from
# `defaults.models.anthropic` (or its own `stages[].model`). An `openai` stage (Codex)
# supplies its own model, so an all-Codex graph needs no `defaults.models`.
# Every OTHER block below is optional — delete any one to accept its default.
# ===========================================================================

# --- Model resolution --------------------------------------------------------
# Precedence per stage, highest first (most specific wins):
#   1. Per-request override supplied at dispatch time (workflow input / command)
#   2. This stage's model      -> stages[].model.(tiers.<tier> | default)
#   3. Org/account default     -> defaults.models.<provider>.(tiers.<tier> | default)
# If none of 1-3 resolves, the installer/run FAILS LOUDLY naming the stage/key —
# there is no hidden toolkit fallback.
# A resolved value that matches a `models.aliases` name expands per provider.
# The toolkit ships placeholders, never hardcoded versions.
# ---------------------------------------------------------------------------

# Org/account-level defaults, keyed by provider id. Supported: anthropic, openai.
defaults:
  provider: anthropic          # default provider for stages that omit one (anthropic -> Claude Code)
  models:
    anthropic:
      default: "<anthropic-default-model>"
      tiers:
        trivial:  "<anthropic-low-cost-model>"
        standard: "<anthropic-default-model>"
        complex:  "<anthropic-high-capability-model>"
    openai:
      default: "<openai-default-model>"
      tiers:
        trivial:  "<openai-low-cost-model>"
        standard: "<openai-default-model>"
        complex:  "<openai-high-capability-model>"
    # gemini: { default: "<gemini-default-model>" }

# Provider-agnostic model aliases (optional). Reference these names anywhere a
# model is expected; map each per provider so ID churn touches one place.
# models:
#   aliases:
#     fast:     { anthropic: "<anthropic-fast>",   openai: "<openai-fast>" }
#     balanced: { anthropic: "<anthropic-bal>",    openai: "<openai-bal>" }
#     strong:   { anthropic: "<anthropic-strong>", openai: "<openai-strong>" }

# Provider connections (optional). Point at self-hosted / Azure OpenAI / Vertex /
# proxy / on-prem gateways. Supply only the NAME of the key secret, never the key.
# providers:
#   anthropic: { api_key_secret: ANTHROPIC_API_KEY }
#   openai:
#     base_url: ""                       # e.g. https://<resource>.openai.azure.com
#     api_version: ""                    # e.g. Azure OpenAI api-version
#     deployment: ""                     # Azure deployment name
#     api_key_secret: OPENAI_API_KEY

# --- Skills registry (optional) ----------------------------------------------
# A skill is the reusable methodology/content for a stage (checklist, rubric,
# output format) — provider/backend/language-agnostic. Built-ins live in
# templates/skills/<id>/. Register your own or override a shipped one by id.
# skills:
#   code-review:     { source: builtin }
#   security-review: { source: builtin }
#   house-review:    { source: path, path: .agentic/skills/house-review, extends: code-review }

# --- Stages (the agent graph) ------------------------------------------------
# OPTIONAL. Omit to use the profile's stages. Anything you list here is merged
# onto the profile (a stage with the same id overrides). Build a stage from a
# pre-wired agent preset with `from:` and override only what you need; or define
# it fully. Any provider/model works per stage; the tool is derived from the provider
# (anthropic -> Claude Code, openai -> Codex), so a stage sets provider + model, not a backend.
#
# Example: a fuller SDLC mixing presets, providers, models, and skills.
# stages:
#   - id: plan
#     type: plan
#     provider: anthropic
#     model: { default: strong }
#     triggers: [issue_labeled]
#     gate: advisory
#
#   - id: implement
#     type: implement
#     provider: anthropic
#     model: { tiers: { trivial: fast, standard: balanced, complex: strong } }
#     depends_on: [plan]
#     triggers: [issue_labeled, comment_command]
#
#   - id: security
#     from: security-review              # pre-wired preset (skill + gate + triggers)
#     provider: openai                   # OpenAI/Codex reviewer
#     depends_on: [implement]
#
#   - id: review
#     from: code-review                  # pre-wired preset (defaults to the OpenAI/Codex reviewer)
#     depends_on: [implement]
#     # backend: { name: custom, uses: … }  # advanced: pin/override the tool (roadmap adapters)

# --- Dynamic model selection -------------------------------------------------
# Deterministic classifier reuses the review router's change-size + path signal,
# so tier selection costs NO extra model call. A stage may set `tiering: false`.
tiering:
  enabled: true
  classifier: deterministic
  thresholds:
    trivial:
      max_files: 5
      max_lines: 50
      only_paths: ["**/*.md", "docs/**", "**/*.txt"]
    complex:
      min_files: 20
      min_lines: 400

# --- Review routing ----------------------------------------------------------
# Trivial textual changes are fast-path approved WITHOUT a model review. Note `docs/**` is EXCLUDED
# from the fast path: docs often hold operational/security contracts and should be reviewed. Keep
# AGENTS.md / CLAUDE.md (root and nested) excluded too.
routing:
  fast_path:
    globs: ["**/*.md", "LICENSE", ".gitignore", ".gitattributes", ".editorconfig"]
    max_files: 20
    max_lines: 200
    exclude: ["AGENTS.md", "**/AGENTS.md", "CLAUDE.md", "**/CLAUDE.md", "docs/**", ".agentic/**"]

# --- Cost & token budgets ----------------------------------------------------
# Optional ceilings, global or per-stage. on_exceed decides the action.
# budgets:
#   enabled: true
#   per_run:    { max_usd: 2.00, max_tokens: 500000 }
#   per_period: { window: monthly, max_usd: 200.00 }
#   on_exceed: block               # block | downgrade | warn

# --- Prompt-injection guardrails ---------------------------------------------
# Treat content from PRs/issues/comments/diffs as data, not instructions.
# guardrails:
#   untrusted_inputs: [pr_body, issue_body, comments, diff, code_comments]
#   ignore_inline_directives: true
#   allowed_tools: []
#   redact_secrets_in_context: true

# --- Observability / audit trail ---------------------------------------------
# Where run records go — adapt to YOUR stack. Endpoints via variable/secret NAME
# (never hardcoded); secrets always redacted.
# observability:
#   enabled: true
#   format: json                   # json | text
#   sinks:
#     - type: artifact             # none | artifact | file | webhook | otlp
#     - type: otlp
#       endpoint_var: OTEL_EXPORTER_OTLP_ENDPOINT
#       headers_secret: OTEL_EXPORTER_OTLP_HEADERS

# --- Optional add-on modules -------------------------------------------------
modules:
  auto_merge: false                # render the fail-closed auto-merge gate (default: humans merge)
  sonar: false                     # reserved / not rendered — wire code-quality tools tool-agnostically
                                   # via merge.required_status_checks below, not this toggle.

# --- Auto-merge gate policy (only used when modules.auto_merge is true) -------
# merge:
#   method: squash                 # squash | merge | rebase (the repo must have that method enabled)
#   required_status_checks:        # external checks that must be GREEN before auto-merge, identified by
#     - name: "SonarCloud Code Analysis"  #   exact check-run NAME *and* the producing GitHub App's
#       app_id: 12345                     #   immutable numeric id (a same-name check from another App
#     - name: "Checkmarx One"             #   does NOT count). stagr requires the result, never runs the
#       app_id: 67890                     #   tool. Find an App's id via the GitHub API.
#   protected_paths:               # a PR changing any of these is left for a human (never auto-merged) —
#     - ".github/workflows/**"     #   the CI/gate control plane and toolkit config. Defaults to these
#     - ".agentic/**"              #   two; set to [] only if you accept auto-merging changes to your gate.
